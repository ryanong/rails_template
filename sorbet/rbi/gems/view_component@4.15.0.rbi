  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:28
  def initialize_args; end

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:49
  def method_missing(method_name, *args, **, &block); end

  # Implements the Rails renderable interface
  #
  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:42
  def render_in(view_context, &block); end

  # Returns a hash that can be rebuilt into a Proxy instance using +deserialize+
  #
  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:63
  def serialize; end

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:28
  def slot_calls; end

  private

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:101
  def build_component; end

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:92
  def capture_slot_call(method_name, args, &block); end

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:58
  def respond_to_missing?(method_name, include_private = T.unsafe(nil)); end

  # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:88
  def slot_method?(method_name); end

  class << self
    # Rebuilds a Proxy from a serialized hash produced by +serialize+
    #
    # pkg:gem/view_component#lib/view_component/serializable/proxy.rb:12
    def deserialize(hash); end
  end
end

