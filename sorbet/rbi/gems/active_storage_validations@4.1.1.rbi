  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:81
  def signal_process_group(pid, signal); end

  # Waits via a reaper thread + Thread#join(timeout) so fast commands return
  # as soon as they exit (no polling sleep). On timeout, TERM then always KILL
  # the process group — KILL is unconditional because the direct child can exit
  # on TERM while a grandchild forked after the group signal is still alive.
  # The same waiter reaps so we never leave zombies.
  #
  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:56
  def wait_for_command(pid, timeout); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:77
