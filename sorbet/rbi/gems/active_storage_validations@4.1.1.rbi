# = Active Storage Validations \Analyzer
#
# This is an abstract base class for analyzers, which extract metadata from attachables.
# See ActiveStorageValidations::Analyzer::VideoAnalyzer for an example of a concrete subclass.
#
# Heavily (not to say 100%) inspired by Rails own ActiveStorage::Analyzer
#
# pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:14
class ActiveStorageValidations::Analyzer
  include ::ActiveStorageValidations::ASVAttachable
  include ::ActiveStorageValidations::ASVCommandable
  include ::ActiveStorageValidations::ASVLoggable

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:21
  def initialize(attachable, timeout: T.unsafe(nil)); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:19
  def attachable; end

  # Override this method in a concrete subclass. Have it return a String content type.
  #
  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:27
  def content_type; end

  # Override this method in a concrete subclass. Have it return a Hash of metadata.
  #
  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:32
  def metadata; end

  private

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:60
  def instrument(analyzer); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:76
  def mark_timed_out!(payload, command); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:43
  def media(tempfile); end

  # Override this method in a concrete subclass. Have it return a media object.
  #
  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:50
  def media_from_path(path); end

  # Override this method in a concrete subclass. Have it yield a media object.
  #
  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:39
  def read_media; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer.rb:54
  def timeout_in_seconds; end
end

# = ActiveStorageValidations Audio \Analyzer
#
# Extracts the following from an audio attachable:
#
# * Duration (seconds)
# * Bit rate (bits/s)
# * Sample rate (hertz)
# * Audio (true if file has an audio channel, false if not)
# * Tags (internal metadata)
#
# Example:
#
#   ActiveStorageValidations::Analyzer::AudioAnalyzer.new(attachable).metadata
#   # => { duration: 5.0, bit_rate: 320340, sample_rate: 44100, audio: true, tags: { encoder: "Lavc57.64", ... } }
#
# This analyzer requires the {FFmpeg}[https://www.ffmpeg.org] system library, which is not provided by \Rails.
#
# pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:22
class ActiveStorageValidations::Analyzer::AudioAnalyzer < ::ActiveStorageValidations::Analyzer
  include ::ActiveStorageValidations::ASVFFProbable

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:25
  def metadata; end

  private

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:39
  def audio?; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:48
  def bit_rate; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:43
  def duration; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:53
  def sample_rate; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/audio_analyzer.rb:58
  def tags; end
end

# = ActiveStorageValidations ContentType \Analyzer
