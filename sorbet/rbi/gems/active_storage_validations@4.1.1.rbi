  def validate_each(record, attribute, _value); end

  private

  # pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:52
  def is_valid?(record, attribute, attachable, metadata); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:60
  def vips_unanalyzable_by_policy?(attachable); end

  class << self
    # pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:76
    def reset_vips_untrusted_operations_blocked_cache!; end

    # Detect whether libvips is currently blocking untrusted operations.
    # There is no public getter for `Vips.block_untrusted`, so we probe whether
    # an untrusted loader (svgload) is available via `vips_foreign_find_load`.
    #
    # pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:70
    def vips_untrusted_operations_blocked?; end

    private

    # pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:82
    def detect_vips_untrusted_operations_blocked?; end
  end
end

# pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:17
ActiveStorageValidations::ProcessableFileValidator::ERROR_TYPES = T.let(T.unsafe(nil), Array)

# pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:20
ActiveStorageValidations::ProcessableFileValidator::METADATA_KEYS = T.let(T.unsafe(nil), Array)

# Content types whose libvips loaders are marked untrusted / unfuzzed
# (VIPS_OPERATION_UNTRUSTED). After Rails calls `Vips.block_untrusted(true)`,
# analysis of these types returns no width/height (empty metadata here),
# which is not the same as a corrupt / unprocessable file.
#
# Matches the formats called out in the Active Storage security release
# changelogs (7.2.3.2 / 8.0.5.1 / 8.1.3.1):
# https://github.com/rails/rails/blob/v8.1.3.1/activestorage/CHANGELOG.md
# https://github.com/rails/rails/security/advisories/GHSA-xr9x-r78c-5hrm
#
# pkg:gem/active_storage_validations#lib/active_storage_validations/processable_file_validator.rb:31
ActiveStorageValidations::ProcessableFileValidator::VIPS_UNTRUSTED_CONTENT_TYPES = T.let(T.unsafe(nil), Array)

