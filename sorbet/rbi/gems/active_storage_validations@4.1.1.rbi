  def media_from_path(path); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/image_magick.rb:59
  def parse_identify_output(stdout); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/image_magick.rb:22
  def read_media; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/image_magick.rb:68
  def rotated_image?(image); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/image_magick.rb:72
  def supported?; end
end

