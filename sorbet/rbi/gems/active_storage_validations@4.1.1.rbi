  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/vips.rb:74
  def supported?; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/image_analyzer/vips.rb:52
  def wait_for_vips_load_thread; end
end

