# ActiveStorageValidations::ASVCommandable
#
# Runs external analyzer commands with an optional deadline and process-group
# kill. Used by analyzers that shell out (ffprobe, pdfinfo, file, identify).
#
# pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:8
module ActiveStorageValidations::ASVCommandable
  extend ::ActiveSupport::Concern

  private

  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:87
  def close_pipe(io); end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:91
  def monotonic_time; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/shared/asv_commandable.rb:21
