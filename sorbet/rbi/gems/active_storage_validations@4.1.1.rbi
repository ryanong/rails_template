  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/content_type_analyzer.rb:50
  def missing_backend_error; end

  # pkg:gem/active_storage_validations#lib/active_storage_validations/analyzer/content_type_analyzer.rb:29
  def read_media; end
